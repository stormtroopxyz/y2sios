<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.BlueTool</string>
	<!-- the S20+: Apple's BlueTool replaced (src/bluetool_stub.c): the kernel boots the BCM4375's Bluetooth
	     (bsd/dev/redwood_exynos_bt.c); this answers bluetoothd's "boot"/"init" scripts with success -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/bluetool_stub</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.apple.BlueTool</key>
		<true/>
	</dict>
	<key>UserName</key>
	<string>mobile</string>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
